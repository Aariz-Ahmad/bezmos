{
  "manifest_version": 3,
  "name": "Bezmos",
  "short_name": "Bezmos",
  "version": "1.0.0",
  "description": "Easily create any curve, any line, any polygon, and more.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open a Desmos graph to use it!"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.desmos.com/calculator*", "https://desmos.com/calculator*"],
      "js": ["templates.js", "content-scripts/isolated.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.desmos.com/calculator*", "https://desmos.com/calculator*"],
      "js": ["content-scripts/inject.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
